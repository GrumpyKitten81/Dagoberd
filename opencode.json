{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".agents/skills"]
  },
  "permission": {
    "skill": "allow",
    "read": {
      "dagoberd.local.toml": "ask",
      ".env": "deny"
    },
    "bash": {
      "git push --force*": "deny",
      "git push *": "ask"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "dagoberd-*": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "dagoberd-*": "allow"
        }
      }
    }
  },
  "mcp": {
    "dagoberd": {
      "type": "local",
      "command": ["./Scripts/dagoberd-mcp.sh"],
      "cwd": ".",
      "enabled": true,
      "timeout": 120000
    }
  }
}
